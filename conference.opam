# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A WebRTC conferencing server: one speaker, many attendees"
description: """
A selective forwarding unit and the pages that drive it: a speaker sends
microphone, camera and desktop once, and the server forwards the packets to
everyone watching, as an example of what the webrtc libraries can be used
for."""
maintainer: ["Samuel Mimram <smimram@gmail.com>"]
authors: ["Samuel Mimram <smimram@gmail.com>"]
license: "LGPL-2.1-or-later"
homepage: "https://github.com/smimram/ocaml-webrtc"
bug-reports: "https://github.com/smimram/ocaml-webrtc/issues"
depends: [
  "dune" {>= "3.14"}
  "ocaml" {>= "4.14"}
  "webrtc"
  "dream"
  "lwt"
  "lwt_ppx"
  "mirage-crypto-rng" {>= "1.0.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/smimram/ocaml-webrtc.git"
